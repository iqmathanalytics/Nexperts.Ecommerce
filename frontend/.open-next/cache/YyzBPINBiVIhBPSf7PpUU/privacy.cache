/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart h-5 w-5\" aria-hidden=\"true\"><path d=\"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\"></path></svg></a><a class=\"relative rounded-md p-2 transition hover:bg-background\" aria-label=\"Cart\" href=\"/login?next=%2Fcart\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shopping-bag h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 10a4 4 0 0 1-8 0\"></path><path d=\"M3.103 6.034h17.794\"></path><path d=\"M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z\"></path></svg></a><a class=\"rounded-md p-2 transition hover:bg-background\" aria-label=\"Account\" href=\"/login\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-user h-5 w-5\" aria-hidden=\"true\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle></svg></a></div></div></header><main class=\"flex-1 text-ink\"><div class=\"mx-auto max-w-3xl px-4 py-16 text-ink\"><p class=\"text-xs font-semibold uppercase tracking-[0.28em] text-muted\">Nexperts</p><h1 class=\"mt-3 text-3xl font-semibold tracking-tight md:text-4xl\">Privacy Policy</h1><div class=\"prose-store mt-8 space-y-4 text-sm leading-relaxed text-muted\"><p>Nexperts<!-- --> collects account information (name, email, phone, addresses) to process orders, provide customer support, and improve your shopping experience.</p><p>Order and payment details are stored securely on our servers. We do not sell your personal data to third parties. Payment card data is not stored when using cash on delivery.</p><p>You may update your profile, addresses, and password from your account settings. Contact us to request account deletion or a copy of your data.</p><p>We may update this policy from time to time. Continued use of the store constitutes acceptance of changes.</p></div></div><!--$--><!--/$--></main><footer class=\"mt-auto border-t border-line bg-surface text-ink\"><div class=\"mx-auto grid max-w-7xl gap-10 px-4 py-14 md:grid-cols-4\"><div><p class=\"text-2xl font-bold\">Nexperts</p><p class=\"mt-3 max-w-xs text-sm leading-relaxed text-muted\">Clothing only — dresses, tops, bottoms, ethnic wear, and outerwear.</p></div><div><p class=\"mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted\">Shop</p><a class=\"block text-sm text-ink/80 transition hover:text-ink\" href=\"/products\">All clothing</a><a class=\"mt-2 block text-sm text-ink/80 transition hover:text-ink\" href=\"/category/dresses\">Dresses</a><a class=\"mt-2 block text-sm text-ink/80 transition hover:text-ink\" href=\"/category/tops\">Tops</a><a class=\"mt-2 block text-sm text-ink/80 transition hover:text-ink\" href=\"/category/bottoms\">Bottoms</a><a class=\"mt-2 block text-sm text-ink/80 transition hover:text-ink\" href=\"/category/ethnic-wear\">Ethnic Wear</a><a class=\"mt-2 block text-sm text-ink/80 transition hover:text-ink\" href=\"/category/outerwear\">Outerwear</a></div><div><p class=\"mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted\">Help</p><a class=\"block text-sm text-ink/80 transition hover:text-ink\" href=\"/contact\">Contact</a><a class=\"mt-2 block text-sm text-ink/80 transition hover:text-ink\" href=\"/privacy\">Privacy</a><a class=\"mt-2 block text-sm text-ink/80 transition hover:text-ink\" href=\"/terms\">Terms</a><p class=\"mt-3 text-sm text-ink/80\">Shipping in 2–5 days</p><p class=\"mt-2 text-sm text-ink/80\">7-day returns</p></div><div><p class=\"mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-muted\">Account</p><a class=\"block text-sm text-ink/80 transition hover:text-ink\" href=\"/login\">Sign in</a><a class=\"mt-2 block text-sm text-ink/80 transition hover:text-ink\" href=\"/account/orders\">Orders</a></div></div></footer></div><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[1661,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/2x2nccjo1816e.js\\\",\\\"/_next/static/chunks/35aq79a-qwpyh.js\\\"],\\\"Providers\\\"]\\n3:I[39756,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/2x2nccjo1816e.js\\\",\\\"/_next/static/chunks/35aq79a-qwpyh.js\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/2x2nccjo1816e.js\\\",\\\"/_next/static/chunks/35aq79a-qwpyh.js\\\"],\\\"default\\\"]\\n5:I[59890,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/2x2nccjo1816e.js\\\",\\\"/_next/static/chunks/35aq79a-qwpyh.js\\\",\\\"/_next/static/chunks/3m-vvkt5zkpez.js\\\"],\\\"Header\\\"]\\n6:I[59890,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/2x2nccjo1816e.js\\\",\\\"/_next/static/chunks/35aq79a-qwpyh.js\\\",\\\"/_next/static/chunks/3m-vvkt5zkpez.js\\\"],\\\"Footer\\\"]\\nc:I[68027,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/2x2nccjo1816e.js\\\",\\\"/_next/static/chunks/35aq79a-qwpyh.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2al60z-6i-id-.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/1b99372b3eaef0c8-s.p.1gsd1jahc5dg_.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\na:X\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"privacy\\\"],\\\"q\\\":\\\"\